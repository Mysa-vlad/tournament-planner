{
  "name": "tournament-planner",
  "version": "0.1.0",
  "description": "REST API для організації аматорських футбольних турнірів",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run audit:deps && npm run test && npm run build && npm run test:e2e",
    "prepare": "husky",
    "dev:static": "tsx watch --env-file=.env.static src/server.ts",
    "probe:queries": "tsx --env-file=.env.probe scripts/probe-queries.ts",
    "probe:edge": "tsx --env-file=.env.probe scripts/probe-edge-cases.ts",
    "test": "vitest run --coverage",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "mutation": "stryker run",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "author": "Мусієнко Владислав (ІО-44)",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^9.0.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": [
      "prettier --check",
      "eslint --max-warnings 0"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --check"
    ]
  }
}
